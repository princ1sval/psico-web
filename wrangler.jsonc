// Publicação no Cloudflare (Worker só com arquivos estáticos, sem build).
// Publica a raiz do repositório, MENOS o que está listado em .assetsignore
// (docs internos, CLAUDE.md, kit original, configurações).
{
  "name": "psico-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    // endereço que não existe → mostra a 404.html (com status 404)
    "not_found_handling": "404-page"
  }
}
